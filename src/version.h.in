/* version.h - generated by CMake from src/version.h.in.  The version is set
   in CMakeLists.txt (project(CRYPTARA VERSION ...)); bump_version.sh changes
   it.  Included by the C++ sources and by assets/cryptara.rc. */
#ifndef CRYPTARA_VERSION_H
#define CRYPTARA_VERSION_H

#define CRYPTARA_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define CRYPTARA_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define CRYPTARA_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define CRYPTARA_VERSION_STRING "@PROJECT_VERSION@"

#endif
